# Copy this file to .env. Never commit the real .env file.
GEMINI_API_KEY=
AERIS_GEMINI_MODEL=gemini-3.6-flash
AERIS_AI_ENABLED=true

# Keep true until every command has been tested safely.
AERIS_DRY_RUN=true

# Windows paths are separated with semicolons.
AERIS_ALLOWED_PATHS=C:\Users\YourName\Desktop;C:\Users\YourName\Documents;C:\Users\YourName\Downloads

# Use * for all HTTP/HTTPS domains, or a comma-separated allowlist.
AERIS_ALLOWED_DOMAINS=*

# Aeris downloads only to this folder, never overwrites an existing file, and
# never automatically runs a downloaded program.
AERIS_DOWNLOAD_DIR=C:\Users\YourName\Downloads
AERIS_MAX_DOWNLOAD_MB=2048
AERIS_REQUIRE_SIGNED_INSTALLERS=true

# Multilingual Whisper model works for English and Hinglish. The first voice
# run downloads this model.
AERIS_VOICE_MODEL=small
AERIS_VOICE_SECONDS=6
AERIS_VOICE_DEVICE=cpu
AERIS_VOICE_LANGUAGE=en
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# Aeris begins wake-word standby when the desktop app opens. Say "Aeris" before
# the command. The HUD always shows when the microphone is listening.
AERIS_HANDS_FREE=true
AERIS_WAKE_WORD=aeris
AERIS_STARTUP_GREETING=true

# New AI-generated coding projects are created here and never overwrite an
# existing project. This folder must be inside AERIS_ALLOWED_PATHS.
AERIS_CODING_WORKSPACE=C:\Users\YourName\Documents\Aeris Projects

# Download this OAuth file from Google Cloud. Do not commit it.
AERIS_GMAIL_CREDENTIALS=credentials.json

# Add local application paths here.
AERIS_APP_CATALOG=config/apps.windows.json
AERIS_PACKAGE_CATALOG=config/packages.windows.json
